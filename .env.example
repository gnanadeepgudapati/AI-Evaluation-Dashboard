GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Arena provider keys ---
# These are NEVER read from the server environment in production. Users
# bring their own keys (BYOK) via request headers (X-Anthropic-Key,
# X-OpenAI-Key, X-Gemini-Key) from the React frontend. The variables below
# exist only so you can quickly test adapters locally/manually if needed —
# they are not consumed by the /compare endpoint.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here